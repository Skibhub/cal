local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Vòng lặp spam bay tới chỗ Story và bấm E liên tục cho đến khi tìm thấy và hoàn thành
task.spawn(function()
    while true do
        local storyArea = workspace:FindFirstChild("InteractZones") and workspace.InteractZones:FindFirstChild("Story")
        
        if storyArea then
            local targetCFrame = storyArea:IsA("Model") and storyArea:GetPrimaryPartCFrame() or storyArea.CFrame
            
            local currentCharacter = LocalPlayer.Character
            if currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart") then
                local currentRootPart = currentCharacter.HumanoidRootPart
                local distance = (currentRootPart.Position - targetCFrame.Position).Magnitude
                local speed = 150 
                local timeToTravel = distance / speed

                local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
                local tween = TweenService:Create(currentRootPart, tweenInfo, {CFrame = targetCFrame + Vector3.new(0, 3, 0)})
                
                tween:Play()
                print("Đang bay đến khu vực Story...")

                tween.Completed:Wait()
                task.wait(0.5) 
                
                -- Auto bấm E liên tục vài lần khi vừa tới để chắc chắn nhận diện
                for i = 1, 3 do
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.1)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    task.wait(0.2)
                end
                
                print("Đã đến khu vực Story và bấm phím E thành công!")
                break
            end
        end
        task.wait(1)
    end
end)

-- Quay màn hình sang phải đúng 1 lần tầm 25% màn hình (khoảng 90 độ)
task.spawn(function()
    task.wait(1)
    pcall(function()
        Camera.CFrame = Camera.CFrame * CFrame.Angles(0, math.rad(-90), 0)
    end)
end)

-- Phần còn lại chạy khi không tìm thấy (hoặc để dự phòng logic click chuột tự động)
local storyAreaCheck = workspace:FindFirstChild("InteractZones") and workspace.InteractZones:FindFirstChild("Story")
if not storyAreaCheck then
    print("Không tìm thấy khu vực Story trong InteractZones! Bắt đầu chạy logic click chuột tự động...")

    -- Vòng lặp bấm phím 1 (cứ 3 giây bấm 1 lần)
    task.spawn(function()
        while true do
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                task.wait(0.1)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
            end)
            task.wait(3)
        end
    end)

    -- Vòng lặp click chuột: Lấy mốc tọa độ của 10 cái đầu (đã cộng thêm 100px) làm gốc rồi áp dụng chu kỳ lên xuống 20px ngay từ đầu
    task.spawn(function()
        task.wait(1)
        
        local clickCount = 0
        
        while true do
            pcall(function()
                local currentCharacter = LocalPlayer.Character
                if currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart") then
                    local currentRootPart = currentCharacter.HumanoidRootPart
                    
                    -- Lấy vị trí cao hơn nhân vật 1 stud
                    local targetWorldPos = currentRootPart.Position + Vector3.new(0, 1, 0)
                    
                    -- Chuyển đổi tọa độ 3D sang 2D màn hình
                    local screenPos, onScreen = Camera:WorldToScreenPoint(targetWorldPos)
                    
                    if onScreen then
                        -- Sang phải tổng cộng cộng 320 ở X
                        local currentX = screenPos.X + 50 + 150
                        
                        -- Cố định mốc tọa độ cơ bản của 10 cái click đầu tiên (đã cộng thêm 100px)
                        local baseOffset = 50
                        
                        -- Tính toán chu kỳ tụt xuống 20px rồi lên lại 20px dựa trực tiếp trên mốc đó ngay từ click đầu tiên
                        local halfCycle = 15 
                        local fullCycle = 30
                        local posInCycle = clickCount % fullCycle
                        local dropOffset = 0
                        
                        if posInCycle < halfCycle then
                            local stepIndex = math.floor(posInCycle / 5)
                            dropOffset = stepIndex * 20
                        else
                            local upPos = posInCycle - halfCycle
                            local stepIndex = math.floor(upPos / 5)
                            dropOffset = 60 - (stepIndex * 20)
                        end
                        
                        local currentY = screenPos.Y + baseOffset + dropOffset
                        
                        VirtualInputManager:SendMouseButtonEvent(currentX, currentY, 0, true, game, 1)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(currentX, currentY, 0, false, game, 1)
                        
                        clickCount = clickCount + 1
                    end
                end
            end)
            task.wait(1)
        end
    end)
end
